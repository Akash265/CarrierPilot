 import { z } from "zod";
 
+/** An empty or whitespace-only value (e.g. `AI_MONTHLY_BUDGET_USD=` in .env) counts as unset, so it gets the default. */
+const blankAsUnset = (value: unknown) => (typeof value === "string" && value.trim() === "" ? undefined : value);
+
 const envSchema = z
