diff --git a/.env.example b/.env.example
index ab4ca8b..f5a49cc 100644
--- a/.env.example
+++ b/.env.example
@@ -70,6 +70,18 @@ VOYAGE_EMBEDDING_MODEL=voyage-3.5
 # OUTCOME_MODEL_MIN_DECIDED=30
 # OUTCOME_MODEL_MIN_PER_CLASS=8
 
+# Phase 11a AI cost control. Monthly ceiling in USD on ESTIMATED AI spend (Anthropic + Voyage, from a built-in
+# price table -- not your invoice). At the ceiling every new AI call is blocked until the next UTC month.
+# 0 means no ceiling. Blank uses the default.
+# AI_MONTHLY_BUDGET_USD=20
+# Percent of the ceiling at which the app starts warning (1-100).
+# AI_BUDGET_WARN_PERCENT=80
+# Optional Langfuse export (metadata only: operation, model, tokens, cost, latency, outcome -- never prompt or
+# response text). Set all three or none; Langfuse Cloud or self-hosted.
+# LANGFUSE_HOST=https://cloud.langfuse.com
+# LANGFUSE_PUBLIC_KEY=
+# LANGFUSE_SECRET_KEY=
+
 # Phase 8 browser autofill (services/browser-worker, run on the host, not in Docker).
 # Override the Chrome binary the worker launches; omitted, it uses Playwright's "chrome" channel.
 # BROWSER_EXECUTABLE_PATH=
